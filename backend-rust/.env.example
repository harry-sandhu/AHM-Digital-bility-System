MONGO_URI=mongodb://localhost:27017/bilty
PORT=5000

# Required. The server refuses to start without this set.
JWT_SECRET=replace-with-a-long-random-string

# Origin(s) allowed to call this API in production. Separate multiple origins with commas.
FRONTEND_URL=https://ahm-digital-bility-system.vercel.app

# Required only on first boot, before any superadmin user exists yet.
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
