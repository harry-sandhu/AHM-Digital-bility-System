# ---- Copy to .env on the VPS and fill in. Never commit the real .env. ----

# Public API address (a DNS "A" record for this name must point at the VPS)
API_DOMAIN=api.apnibilty.com

# GitHub user/org that owns the repo (lower case) - where the images are published
GITHUB_OWNER=harry-sandhu

# Same MongoDB connection string the backend uses on Render today
MONGO_URI=

# Long random secret (the backend refuses to start without it). Generate: openssl rand -hex 48
JWT_SECRET=

# Browser origins allowed to call the API, comma separated, no trailing slash
FRONTEND_URL=https://apnibilty.com,https://www.apnibilty.com

# Only needed on the very first start, before a superadmin exists
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=

# Shared secret between the backend and the OCR service. Generate: openssl rand -hex 24
OCR_KEY=
