MONGO_URI=mongodb://localhost:27017/bilty
PORT=5000

# Required. The server refuses to start without this set.
JWT_SECRET=replace-with-a-long-random-string

# Origin allowed to call this API in production (e.g. https://your-frontend-domain.com).
# In development, leaving this unset allows all origins. In production, leaving it
# unset blocks all cross-origin requests.
FRONTEND_URL=

# Optional: used by the superadmin seeder on first boot if no superadmin exists yet.
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
